rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTruckId(truckId) {
      return truckId in [
        'nordic_fh540',
        'valkyrie_s730',
        'titan_579',
        'colossus_w900',
        'bison_timber',
        'atlas_tanker',
        'kodiak_flatbed',
        'carrier_trans9'
      ];
    }

    function isValidSteeringMode(mode) {
      return mode in ['WHEEL', 'BUTTONS', 'TILT'];
    }

    function isValidCameraMode(mode) {
      return mode in [
        'EXTERIOR_2D', 'CAB_2D', 'SIDE_2D', 'FRONT_2D',
        'TOPDOWN_2D', 'CHASE', 'CAB', 'HOOD'
      ];
    }

    function isValidLiveryStyle(style) {
      return style in ['CLASSIC', 'RACING', 'BOLT', 'EXECUTIVE'];
    }

    function isValidTrailerType(trailer) {
      return trailer in [
        'REEFER_BOX', 'FUEL_TANKER', 'TIMBER_LOGS',
        'FLATBED_EXCAVATOR', 'CAR_CARRIER', 'WIND_TURBINE', 'AGRI_GRAIN'
      ];
    }

    function isValidContractDifficulty(diff) {
      return diff in ['FACIL', 'MEDIA', 'ALTA', 'EXTREMA'];
    }

    function isValidContractStatus(status) {
      return status in ['AVAILABLE', 'ACTIVE', 'COMPLETED'];
    }

    function isValidDriverProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.driverName is string && data.driverName.size() >= 2 && data.driverName.size() <= 40 &&
             data.credits is int && data.credits >= 0 && data.credits <= 100000000 &&
             data.totalDistanceKm is number && data.totalDistanceKm >= 0 && data.totalDistanceKm <= 10000000 &&
             data.deliveriesCompleted is int && data.deliveriesCompleted >= 0 && data.deliveriesCompleted <= 1000000 &&
             data.xp is int && data.xp >= 0 && data.xp <= 100000000 &&
             (!('level' in data) || (data.level is int && data.level >= 1 && data.level <= 500)) &&
             (!('claimedMilestoneIds' in data) || (data.claimedMilestoneIds is list && data.claimedMilestoneIds.size() <= 20 && (data.claimedMilestoneIds.size() == 0 || data.claimedMilestoneIds[0] is string))) &&
             (!('activeContractId' in data) || (data.activeContractId is string && data.activeContractId.size() <= 128)) &&
             (!('contractsCompleted' in data) || (data.contractsCompleted is int && data.contractsCompleted >= 0 && data.contractsCompleted <= 1000000)) &&
             isValidTruckId(data.selectedTruckId) &&
             data.unlockedTruckIds is list && data.unlockedTruckIds.size() >= 1 && data.unlockedTruckIds.size() <= 12 &&
             data.unlockedTruckIds[0] is string &&
             (!('paintColorHex' in data) || (data.paintColorHex is string && data.paintColorHex.size() >= 4 && data.paintColorHex.size() <= 9)) &&
             (!('liveryStyle' in data) || isValidLiveryStyle(data.liveryStyle)) &&
             (!('bullbarInstalled' in data) || data.bullbarInstalled is bool) &&
             (!('roofLightbarInstalled' in data) || data.roofLightbarInstalled is bool) &&
             (!('aeroSpoilerInstalled' in data) || data.aeroSpoilerInstalled is bool) &&
             (!('chromeExhaustInstalled' in data) || data.chromeExhaustInstalled is bool) &&
             (!('truckDamagePercent' in data) || (data.truckDamagePercent is int && data.truckDamagePercent >= 0 && data.truckDamagePercent <= 100)) &&
             isValidSteeringMode(data.steeringMode) &&
             data.steeringSensitivity is number && data.steeringSensitivity >= 0.4 && data.steeringSensitivity <= 2.0 &&
             isValidCameraMode(data.cameraMode) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDeliveryRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 64 &&
             data.routeName is string && data.routeName.size() >= 2 && data.routeName.size() <= 80 &&
             data.cargoName is string && data.cargoName.size() >= 2 && data.cargoName.size() <= 80 &&
             isValidTruckId(data.truckId) &&
             data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 5000 &&
             data.earnedCredits is int && data.earnedCredits >= 0 && data.earnedCredits <= 1000000 &&
             data.damagePercent is int && data.damagePercent >= 0 && data.damagePercent <= 100 &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 86400 &&
             data.perfectDelivery is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDeliveryContract(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 80 &&
             data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 50 &&
             data.cargoName is string && data.cargoName.size() >= 2 && data.cargoName.size() <= 80 &&
             data.cargoTons is int && data.cargoTons >= 5 && data.cargoTons <= 60 &&
             isValidTrailerType(data.trailerType) &&
             data.originCity is string && data.originCity.size() >= 2 && data.originCity.size() <= 40 &&
             data.destinationCity is string && data.destinationCity.size() >= 2 && data.destinationCity.size() <= 40 &&
             data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 64 &&
             data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 5000 &&
             isValidContractDifficulty(data.difficulty) &&
             data.rewardCredits is int && data.rewardCredits >= 1000 && data.rewardCredits <= 500000 &&
             data.rewardXp is int && data.rewardXp >= 50 && data.rewardXp <= 25000 &&
             data.bonusPerfectCredits is int && data.bonusPerfectCredits >= 0 && data.bonusPerfectCredits <= 150000 &&
             data.requiredLevel is int && data.requiredLevel >= 1 && data.requiredLevel <= 500 &&
             isValidContractStatus(data.status) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConvoyRoom(data) {
      return data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 10 &&
             data.roomName is string && data.roomName.size() >= 2 && data.roomName.size() <= 50 &&
             data.hostId is string && isValidId(data.hostId) &&
             data.hostName is string && data.hostName.size() >= 2 && data.hostName.size() <= 40 &&
             data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 64 &&
             data.privateRoom is bool &&
             data.status in ['OPEN', 'DRIVING'] &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 8 &&
             data.memberUids[0] is string &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConvoyPlayer(data, playerId) {
      return data.userId is string && data.userId == playerId &&
             data.driverName is string && data.driverName.size() >= 2 && data.driverName.size() <= 40 &&
             isValidTruckId(data.truckId) &&
             data.paintColorHex is string && data.paintColorHex.size() >= 4 && data.paintColorHex.size() <= 9 &&
             data.roadS is number && data.roadS >= 0 && data.roadS <= 20000 &&
             data.laneOffset is number && data.laneOffset >= -12.0 && data.laneOffset <= 12.0 &&
             data.speedKmh is int && data.speedKmh >= 0 && data.speedKmh <= 220 &&
             data.headlightsOn is bool &&
             data.hornActive is bool &&
             data.online is bool &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidConvoyMessage(data, senderUid) {
      return data.userId is string && data.userId == senderUid &&
             data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 40 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isConvoyMember(roomId) {
      return isSignedIn() &&
             request.auth.uid in get(/databases/$(database)/documents/convoyRooms/$(roomId)).data.memberUids;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'driverName', 'credits', 'totalDistanceKm',
                         'deliveriesCompleted', 'xp', 'selectedTruckId', 'unlockedTruckIds',
                         'steeringMode', 'steeringSensitivity', 'cameraMode', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'driverName', 'credits', 'totalDistanceKm',
                         'deliveriesCompleted', 'xp', 'level', 'claimedMilestoneIds',
                         'activeContractId', 'contractsCompleted',
                         'selectedTruckId', 'unlockedTruckIds',
                         'paintColorHex', 'liveryStyle', 'bullbarInstalled',
                         'roofLightbarInstalled', 'aeroSpoilerInstalled', 'chromeExhaustInstalled',
                         'truckDamagePercent',
                         'steeringMode', 'steeringSensitivity', 'cameraMode', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidDriverProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidDriverProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Update control / camera / truck selection settings
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'driverName', 'selectedTruckId', 'steeringMode', 'steeringSensitivity', 'cameraMode', 'level', 'updatedAt'
                         ]) ||
                         // Action 2: Purchase / unlock a truck in the garage
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'credits', 'selectedTruckId', 'unlockedTruckIds', 'updatedAt'
                         ]) ||
                         // Action 3: Complete a freight delivery or contract
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'credits', 'totalDistanceKm', 'deliveriesCompleted', 'contractsCompleted',
                           'activeContractId', 'xp', 'level', 'truckDamagePercent', 'updatedAt'
                         ]) ||
                         // Action 4: Customize paint & accessories in Workshop
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'credits', 'paintColorHex', 'liveryStyle', 'bullbarInstalled',
                           'roofLightbarInstalled', 'aeroSpoilerInstalled', 'chromeExhaustInstalled', 'updatedAt'
                         ]) ||
                         // Action 5: Repair truck or adjust workshop credits/damage
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'credits', 'truckDamagePercent', 'updatedAt'
                         ]) ||
                         // Action 6: Player profile management & career progression (level, xp, credits, milestones, controls)
                         ((!('level' in existing()) || !('level' in incoming()) || incoming().level >= existing().level) &&
                          incoming().xp >= existing().xp &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'driverName', 'level', 'xp', 'credits', 'claimedMilestoneIds',
                            'steeringMode', 'steeringSensitivity', 'cameraMode', 'updatedAt'
                          ])) ||
                         // Action 7: Select or release active contract on driver profile
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'activeContractId', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /deliveries/{deliveryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(deliveryId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deliveryId) &&
                         incoming().keys().hasAll([
                           'userId', 'routeId', 'routeName', 'cargoName', 'truckId',
                           'distanceKm', 'earnedCredits', 'damagePercent', 'durationSeconds',
                           'perfectDelivery', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'routeId', 'routeName', 'cargoName', 'truckId',
                           'distanceKm', 'earnedCredits', 'damagePercent', 'durationSeconds',
                           'perfectDelivery', 'createdAt'
                         ]) &&
                         isValidDeliveryRecord(incoming(), userId);

        // Delivery history entries are immutable audit logs
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(deliveryId);
      }

      match /contracts/{contractId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(contractId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(contractId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'companyName', 'cargoName', 'cargoTons',
                           'trailerType', 'originCity', 'destinationCity', 'routeId',
                           'distanceKm', 'difficulty', 'rewardCredits', 'rewardXp',
                           'bonusPerfectCredits', 'requiredLevel', 'status',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'companyName', 'cargoName', 'cargoTons',
                           'trailerType', 'originCity', 'destinationCity', 'routeId',
                           'distanceKm', 'difficulty', 'rewardCredits', 'rewardXp',
                           'bonusPerfectCredits', 'requiredLevel', 'status',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().status in ['AVAILABLE', 'ACTIVE'] &&
                         isValidDeliveryContract(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(contractId) &&
                         isValidDeliveryContract(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         existing().status != 'COMPLETED' &&
                         (
                           (existing().status == 'AVAILABLE' && incoming().status == 'ACTIVE' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                           (existing().status == 'ACTIVE' && incoming().status == 'AVAILABLE' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                           (incoming().status == 'COMPLETED' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                         );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(contractId);
      }
    }

    match /convoyRooms/{roomId} {
      // Public rooms and rooms where user is a member are discoverable; private rooms can be fetched directly by invite ID
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && (resource.data.privateRoom == false || request.auth.uid in resource.data.memberUids);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll([
                         'roomCode', 'roomName', 'hostId', 'hostName', 'routeId',
                         'privateRoom', 'status', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'roomCode', 'roomName', 'hostId', 'hostName', 'routeId',
                         'privateRoom', 'status', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidConvoyRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidConvoyRoom(incoming()) &&
                       incoming().hostId == existing().hostId &&
                       incoming().roomCode == existing().roomCode &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Join or leave memberUids
                         incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) ||
                         // Action 2: Host updates route or convoy status
                         (existing().hostId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'routeId', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      match /players/{playerId} {
        allow get: if isValidId(roomId) && isValidId(playerId) && isConvoyMember(roomId);
        allow list: if isValidId(roomId) && isConvoyMember(roomId);

        allow create: if isOwner(playerId) &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isConvoyMember(roomId) &&
                         incoming().keys().hasAll([
                           'userId', 'driverName', 'truckId', 'paintColorHex',
                           'roadS', 'laneOffset', 'speedKmh', 'headlightsOn', 'hornActive', 'online', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'driverName', 'truckId', 'paintColorHex',
                           'roadS', 'laneOffset', 'speedKmh', 'headlightsOn', 'hornActive', 'online', 'updatedAt'
                         ]) &&
                         isValidConvoyPlayer(incoming(), playerId);

        allow update: if isOwner(playerId) &&
                         isValidId(roomId) &&
                         isValidId(playerId) &&
                         isConvoyMember(roomId) &&
                         incoming().userId == existing().userId &&
                         isValidConvoyPlayer(incoming(), playerId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'driverName', 'truckId', 'paintColorHex',
                           'roadS', 'laneOffset', 'speedKmh', 'headlightsOn', 'hornActive', 'online', 'updatedAt'
                         ]);

        allow delete: if isOwner(playerId) && isValidId(roomId) && isValidId(playerId);
      }

      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId) && isConvoyMember(roomId);
        allow list: if isValidId(roomId) && isConvoyMember(roomId);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isConvoyMember(roomId) &&
                         incoming().keys().hasAll(['userId', 'senderName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'senderName', 'text', 'createdAt']) &&
                         isValidConvoyMessage(incoming(), request.auth.uid);

        allow update, delete: if false;
      }
    }
  }
}
