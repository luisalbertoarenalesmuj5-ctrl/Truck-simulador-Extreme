rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTruckId(truckId) {
      return truckId in ['nordic_fh540', 'valkyrie_s730', 'titan_579', 'colossus_w900'];
    }

    function isValidSteeringMode(mode) {
      return mode in ['WHEEL', 'BUTTONS', 'TILT'];
    }

    function isValidCameraMode(mode) {
      return mode in ['CHASE', 'CAB', 'HOOD'];
    }

    function isValidDriverProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.driverName is string && data.driverName.size() >= 2 && data.driverName.size() <= 40 &&
             data.credits is int && data.credits >= 0 && data.credits <= 100000000 &&
             data.totalDistanceKm is number && data.totalDistanceKm >= 0 && data.totalDistanceKm <= 10000000 &&
             data.deliveriesCompleted is int && data.deliveriesCompleted >= 0 && data.deliveriesCompleted <= 1000000 &&
             data.xp is int && data.xp >= 0 && data.xp <= 100000000 &&
             isValidTruckId(data.selectedTruckId) &&
             data.unlockedTruckIds is list && data.unlockedTruckIds.size() >= 1 && data.unlockedTruckIds.size() <= 10 &&
             data.unlockedTruckIds[0] is string &&
             isValidSteeringMode(data.steeringMode) &&
             data.steeringSensitivity is number && data.steeringSensitivity >= 0.4 && data.steeringSensitivity <= 2.0 &&
             isValidCameraMode(data.cameraMode) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDeliveryRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.routeId is string && data.routeId.size() >= 1 && data.routeId.size() <= 64 &&
             data.routeName is string && data.routeName.size() >= 2 && data.routeName.size() <= 80 &&
             data.cargoName is string && data.cargoName.size() >= 2 && data.cargoName.size() <= 80 &&
             isValidTruckId(data.truckId) &&
             data.distanceKm is number && data.distanceKm > 0 && data.distanceKm <= 5000 &&
             data.earnedCredits is int && data.earnedCredits >= 0 && data.earnedCredits <= 1000000 &&
             data.damagePercent is int && data.damagePercent >= 0 && data.damagePercent <= 100 &&
             data.durationSeconds is int && data.durationSeconds >= 1 && data.durationSeconds <= 86400 &&
             data.perfectDelivery is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'driverName', 'credits', 'totalDistanceKm',
                         'deliveriesCompleted', 'xp', 'selectedTruckId', 'unlockedTruckIds',
                         'steeringMode', 'steeringSensitivity', 'cameraMode', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'driverName', 'credits', 'totalDistanceKm',
                         'deliveriesCompleted', 'xp', 'selectedTruckId', 'unlockedTruckIds',
                         'steeringMode', 'steeringSensitivity', 'cameraMode', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidDriverProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidDriverProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Update control / camera / truck selection settings
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'driverName', 'selectedTruckId', 'steeringMode', 'steeringSensitivity', 'cameraMode', 'updatedAt'
                         ]) ||
                         // Action 2: Purchase / unlock a truck in the garage
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'credits', 'selectedTruckId', 'unlockedTruckIds', 'updatedAt'
                         ]) ||
                         // Action 3: Complete a freight delivery
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'credits', 'totalDistanceKm', 'deliveriesCompleted', 'xp', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /deliveries/{deliveryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(deliveryId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deliveryId) &&
                         incoming().keys().hasAll([
                           'userId', 'routeId', 'routeName', 'cargoName', 'truckId',
                           'distanceKm', 'earnedCredits', 'damagePercent', 'durationSeconds',
                           'perfectDelivery', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'routeId', 'routeName', 'cargoName', 'truckId',
                           'distanceKm', 'earnedCredits', 'damagePercent', 'durationSeconds',
                           'perfectDelivery', 'createdAt'
                         ]) &&
                         isValidDeliveryRecord(incoming(), userId);

        // Delivery history entries are immutable audit logs
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(deliveryId);
      }
    }
  }
}
