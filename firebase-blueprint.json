{
  "entities": {
    "DriverProfile": {
      "title": "DriverProfile",
      "description": "Career profile, fleet ownership, workshop paint/accessories, truck damage state, and control settings for a driver.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the driver."
        },
        "driverName": {
          "type": "string",
          "description": "Display name shown on the driver license card (2-40 characters)."
        },
        "credits": {
          "type": "integer",
          "description": "In-game currency earned from freight deliveries."
        },
        "totalDistanceKm": {
          "type": "number",
          "description": "Cumulative kilometers hauled across all routes."
        },
        "deliveriesCompleted": {
          "type": "integer",
          "description": "Total completed freight deliveries."
        },
        "xp": {
          "type": "integer",
          "description": "Driver career experience points."
        },
        "level": {
          "type": "integer",
          "description": "Current driver career level (1-500), synchronized with XP."
        },
        "claimedMilestoneIds": {
          "type": "array",
          "description": "Bounded list of claimed career milestone and certification IDs (max 20)."
        },
        "activeContractId": {
          "type": "string",
          "description": "Optional ID of the currently accepted delivery contract under /users/{userId}/contracts."
        },
        "contractsCompleted": {
          "type": "integer",
          "description": "Total completed random delivery contracts."
        },
        "selectedTruckId": {
          "type": "string",
          "enum": [
            "nordic_fh540",
            "valkyrie_s730",
            "titan_579",
            "colossus_w900",
            "bison_timber",
            "atlas_tanker",
            "kodiak_flatbed",
            "carrier_trans9"
          ],
          "description": "Currently active tractor rig ID."
        },
        "unlockedTruckIds": {
          "type": "array",
          "description": "Bounded list of unlocked truck IDs (max 12)."
        },
        "paintColorHex": {
          "type": "string",
          "description": "Optional custom hex paint color for the active truck (e.g. #1E64B8)."
        },
        "liveryStyle": {
          "type": "string",
          "enum": ["CLASSIC", "RACING", "BOLT", "EXECUTIVE"],
          "description": "Optional custom stripe/livery pattern."
        },
        "bullbarInstalled": {
          "type": "boolean",
          "description": "Whether chrome front bullbar is installed."
        },
        "roofLightbarInstalled": {
          "type": "boolean",
          "description": "Whether roof LED lightbar is installed."
        },
        "aeroSpoilerInstalled": {
          "type": "boolean",
          "description": "Whether cab roof aerodynamic spoiler is installed."
        },
        "chromeExhaustInstalled": {
          "type": "boolean",
          "description": "Whether upgraded dual chrome exhaust stacks are installed."
        },
        "truckDamagePercent": {
          "type": "integer",
          "description": "Persisted mechanical damage of the driver's active truck (0-100)."
        },
        "steeringMode": {
          "type": "string",
          "enum": ["WHEEL", "BUTTONS", "TILT"],
          "description": "Preferred precision steering control scheme."
        },
        "steeringSensitivity": {
          "type": "number",
          "description": "Steering response multiplier (0.4 to 2.0)."
        },
        "cameraMode": {
          "type": "string",
          "enum": ["EXTERIOR_2D", "CAB_2D", "SIDE_2D", "FRONT_2D", "TOPDOWN_2D", "CHASE", "CAB", "HOOD"],
          "description": "Preferred 2D simulation camera perspective."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the driver profile was created (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the driver profile was last updated (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "driverName",
        "credits",
        "totalDistanceKm",
        "deliveriesCompleted",
        "xp",
        "selectedTruckId",
        "unlockedTruckIds",
        "steeringMode",
        "steeringSensitivity",
        "cameraMode",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeliveryRecord": {
      "title": "DeliveryRecord",
      "description": "Completed freight haul log entry with telemetry and payout.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the driver."
        },
        "routeId": {
          "type": "string",
          "description": "Identifier of the completed route."
        },
        "routeName": {
          "type": "string",
          "description": "Human-readable route title."
        },
        "cargoName": {
          "type": "string",
          "description": "Description of the hauled freight."
        },
        "truckId": {
          "type": "string",
          "enum": [
            "nordic_fh540",
            "valkyrie_s730",
            "titan_579",
            "colossus_w900",
            "bison_timber",
            "atlas_tanker",
            "kodiak_flatbed",
            "carrier_trans9"
          ],
          "description": "Truck used during this haul."
        },
        "distanceKm": {
          "type": "number",
          "description": "Distance driven in km."
        },
        "earnedCredits": {
          "type": "integer",
          "description": "Credits awarded for the delivery."
        },
        "damagePercent": {
          "type": "integer",
          "description": "Cargo/truck damage percentage (0 to 100)."
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Haul completion time in seconds."
        },
        "perfectDelivery": {
          "type": "boolean",
          "description": "True if completed with 0% damage."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the delivery was logged (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "routeId",
        "routeName",
        "cargoName",
        "truckId",
        "distanceKm",
        "earnedCredits",
        "damagePercent",
        "durationSeconds",
        "perfectDelivery",
        "createdAt"
      ]
    },
    "ConvoyRoom": {
      "title": "ConvoyRoom",
      "description": "Multiplayer truck convoy session room supporting public lobbies and private invite codes.",
      "type": "object",
      "properties": {
        "roomCode": {
          "type": "string",
          "description": "6-character uppercase invite code."
        },
        "roomName": {
          "type": "string",
          "description": "Convoy display title (2-50 chars)."
        },
        "hostId": {
          "type": "string",
          "description": "Firebase UID of the convoy host."
        },
        "hostName": {
          "type": "string",
          "description": "Driver name of the host."
        },
        "routeId": {
          "type": "string",
          "description": "Route/map ID selected for the convoy."
        },
        "privateRoom": {
          "type": "boolean",
          "description": "True if room is private and joinable via invite code."
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "DRIVING"],
          "description": "Current convoy session state."
        },
        "memberUids": {
          "type": "array",
          "description": "Bounded list of participating driver UIDs (1..8)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the room was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the room was last updated."
        }
      },
      "required": [
        "roomCode",
        "roomName",
        "hostId",
        "hostName",
        "routeId",
        "privateRoom",
        "status",
        "memberUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "ConvoyPlayer": {
      "title": "ConvoyPlayer",
      "description": "Live synchronized position, truck model, paint, and status of a driver inside a convoy room.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase UID of this convoy participant."
        },
        "driverName": {
          "type": "string",
          "description": "Driver display name (2-40 chars)."
        },
        "truckId": {
          "type": "string",
          "description": "Truck model ID driven by this player."
        },
        "paintColorHex": {
          "type": "string",
          "description": "Custom truck hex color."
        },
        "roadS": {
          "type": "number",
          "description": "Longitudinal road position in simulation meters."
        },
        "laneOffset": {
          "type": "number",
          "description": "Lateral lane offset in meters."
        },
        "speedKmh": {
          "type": "integer",
          "description": "Current speed in km/h."
        },
        "headlightsOn": {
          "type": "boolean",
          "description": "Headlight state."
        },
        "hornActive": {
          "type": "boolean",
          "description": "Horn honking indicator."
        },
        "online": {
          "type": "boolean",
          "description": "Whether player is actively driving or connected."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last telemetry sync."
        }
      },
      "required": [
        "userId",
        "driverName",
        "truckId",
        "paintColorHex",
        "roadS",
        "laneOffset",
        "speedKmh",
        "headlightsOn",
        "hornActive",
        "online",
        "updatedAt"
      ]
    },
    "ConvoyMessage": {
      "title": "ConvoyMessage",
      "description": "CB radio chat message inside a multiplayer convoy room.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Sender Firebase UID."
        },
        "senderName": {
          "type": "string",
          "description": "Sender driver display name."
        },
        "text": {
          "type": "string",
          "description": "Chat message body (1-200 chars)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when message was transmitted."
        }
      },
      "required": ["userId", "senderName", "text", "createdAt"]
    },
    "DeliveryContract": {
      "title": "DeliveryContract",
      "description": "Procedurally generated freight delivery contract with difficulty tier, rewards, and status stored under the driver's profile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the driver."
        },
        "title": {
          "type": "string",
          "description": "Generated contract headline (3-80 chars)."
        },
        "companyName": {
          "type": "string",
          "description": "Client logistics company name (2-50 chars)."
        },
        "cargoName": {
          "type": "string",
          "description": "Freight cargo description (2-80 chars)."
        },
        "cargoTons": {
          "type": "integer",
          "description": "Cargo weight in metric tons (5-60)."
        },
        "trailerType": {
          "type": "string",
          "enum": ["REEFER_BOX", "FUEL_TANKER", "TIMBER_LOGS", "FLATBED_EXCAVATOR", "CAR_CARRIER", "WIND_TURBINE", "AGRI_GRAIN"],
          "description": "Trailer type required by this contract."
        },
        "originCity": {
          "type": "string",
          "description": "Pickup city name."
        },
        "destinationCity": {
          "type": "string",
          "description": "Dropoff city name."
        },
        "routeId": {
          "type": "string",
          "description": "Target highway/biome route spec ID."
        },
        "distanceKm": {
          "type": "number",
          "description": "Contract distance in km."
        },
        "difficulty": {
          "type": "string",
          "enum": ["FACIL", "MEDIA", "ALTA", "EXTREMA"],
          "description": "Difficulty tier of the contract."
        },
        "rewardCredits": {
          "type": "integer",
          "description": "Base money reward in credits (1000-500000)."
        },
        "rewardXp": {
          "type": "integer",
          "description": "Base XP reward (50-25000)."
        },
        "bonusPerfectCredits": {
          "type": "integer",
          "description": "Extra payout for 0% cargo damage (0-150000)."
        },
        "requiredLevel": {
          "type": "integer",
          "description": "Minimum driver level required to accept the contract."
        },
        "status": {
          "type": "string",
          "enum": ["AVAILABLE", "ACTIVE", "COMPLETED"],
          "description": "Current contract lifecycle status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when contract was generated."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when contract was last updated."
        }
      },
      "required": [
        "userId",
        "title",
        "companyName",
        "cargoName",
        "cargoTons",
        "trailerType",
        "originCity",
        "destinationCity",
        "routeId",
        "distanceKm",
        "difficulty",
        "rewardCredits",
        "rewardXp",
        "bonusPerfectCredits",
        "requiredLevel",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/DriverProfile" },
      "description": "Stores each driver's career profile, garage ownership, workshop customization, damage, active contract ID, and control settings."
    },
    "/users/{userId}/deliveries/{deliveryId}": {
      "schema": { "$ref": "#/entities/DeliveryRecord" },
      "description": "Stores completed freight haul records for each driver."
    },
    "/users/{userId}/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/DeliveryContract" },
      "description": "Stores randomly generated delivery contracts with difficulty tiers and rewards under the driver's profile."
    },
    "/convoyRooms/{roomId}": {
      "schema": { "$ref": "#/entities/ConvoyRoom" },
      "description": "Stores active multiplayer convoy rooms."
    },
    "/convoyRooms/{roomId}/players/{playerId}": {
      "schema": { "$ref": "#/entities/ConvoyPlayer" },
      "description": "Stores synchronized vehicle telemetry for players in a convoy room."
    },
    "/convoyRooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ConvoyMessage" },
      "description": "Stores CB radio chat messages for a convoy room."
    }
  }
}
